&atm_par

  l_co2d = T                    ! enable prognostic 2D CO2? Used only if flag_co2==T in control.nml. Used only for diagnostic purpose (so far).

  !-----------------------------------------------------------
  ! time steps
  !-----------------------------------------------------------
  nstep_fast = 8                ! number of fast iterations within one slow atmospheric timestep

  !-----------------------------------------------------------
  ! vertical grid
  !-----------------------------------------------------------
  km = 13                       ! number of vertical layers
  pl = 1. 0.975 0.95 0.9 0.85 0.8 0.7 0.6 0.5 0.4 0.3 0.2 0.1 0.      ! pressure levels
  llwr = 15                     ! number of layers for longwave radiation (has to be a multiple of 5)

  tam_init = 30.                ! degC, initial atmospheric temperature at the equator if atm_restart=F in control.nml

  !-----------------------------------------------------------
  ! Coriolis
  !-----------------------------------------------------------
  fcormin  = 1e-5               ! 1/s, minimum Coriolis parameter
  i_fcorg  = 1                  ! how the equatorial singularity of the geostrophic PBL wind is handled.
                                ! u2d.f90 forms ugb = -dpdy*fcorg/ra, vgb = dpdx*fcorg/ra, and
                                !   0   fcorg = 1/fcort, the original. fcort is floored in MAGNITUDE at fcormin but keeps its sign
                                !   1   fcorg = f/(f**2 + fcormin**2)

  !-----------------------------------------------------------
  ! drag and cross-isobar angle parameters 
  !-----------------------------------------------------------
  cd0_ocn = 1.3e-3              ! drag coefficient for momentum over ocean, realistic values : 1.2e-3 - 1.5e-3
  cd0_sic = 1.63e-3             ! drag coefficient for momentum over sea ice, 1.63e-3 in Large and Yaeger 2004
  i_zoro = 3                    ! parameterisation of topographic roughness
  i_acbar = 2                   ! cross-isobar angle closure. Both solve sin(a)/sqrt(1-sin(2a)) = R,
                                ! equivalently tan(a) = R/(1+R), and differ only in R:
                                !   1 = R = cd/sqrt(|f|), the original
                                !   2 = R = cd/(c_acbar_0 + c_acbar_f*phi**c_acbar_p), phi = |f|/f_45
  acbar_max = 0.5               ! maximum cross-isobar angle
  acbar_scale = 1.              ! scaling factor of cross-isobar angle
  c_acbar_0 = 2.75e-3           ! equatorial denominator of the cross-isobar angle (i_acbar=2). Larger means a smaller angle everywhere, most strongly in the tropics.
  c_acbar_f = 1.08e-2           ! Coriolis term of the same denominator (i_acbar=2). Sets how fast the angle falls with latitude.
  c_acbar_p = 1.7               ! exponent on phi in the same denominator (i_acbar=2). The aquaplanet fit is 3.1713e-3 / 1.0132e-2 / 2 
  c_acbar_wind = 1.6            ! factor on the cross-isobar angle used to ROTATE the surface wind in usur.
  i_usur_eps = 1                ! amplitude of the surface (10 m) wind relative to the geostrophic wind, epsa (also scales synsur)
                                !   0 = cos(a)-sin(a), the partner of the cross-isobar angle closure (falls with the angle, i.e. rises poleward)
                                !   1 = log profile from 10 m to h_usur_eps, ln(10/z0)/ln(h_usur_eps/z0), z0 from the neutral cd0 (no orography)
  h_usur_eps = 500.             ! m, top of the log profile for i_usur_eps=1. 750 m gives 0.72 over ocean (ERA/CMIP u10/ug 0.70-0.75)

  !-----------------------------------------------------------
  ! zonal mean overturning circulation parameters
  !-----------------------------------------------------------
  i_mmc_fer = 2                 ! Ferrel cell amplitude: 1 = meridional tslz contrast across the cell, 2 = transient eddy DSE flux
  i_mmc_fer_shape = 2           ! shape of the Ferrel lower branch: 0 = half-sine with the belt-mean amplitude,
                                ! 2 = local TEM closure, vsz = aferz(j)*cos(45)/cos(lat)*|sin(ff)|^c_mmc_fer_q (requires i_mmc_fer=2;
                                !     broader branch with more gradient on the poleward flank; needs c_mmc_fer ~0.7x the half-sine value)
  c_mmc_fer_q = 0.3             ! exponent of the edge taper of the Ferrel branch, used only if i_mmc_fer_shape=2
  i_mmc_had = 1                 ! Hadley cell amplitude: 0 = sea level temperature contrast across the cell only,
                                !                        1 = the same, additionally scaled by the inverse of the tropical
                                !                            boundary layer humidity (moisture mass budget of the cell)
  c_mmc_had = 0.23              ! parameter for strength of Hadley cells
  c_mmc_q = 0.7                 ! exponent of the humidity scaling of the Hadley amplitude, used only if i_mmc_had=1
  q_mmc_ref = 0.0132            ! kg/kg, tropical boundary layer specific humidity at which the humidity scaling is unity, used only if i_mmc_had=1
  c_mmc_fer = 0.05              ! parameter for strength of Ferrel cells
  c_mmc_pol = 0.005             ! parameter for strength of Polar cells
  c_mmc_1 = 5.                  ! shape factor of the ITCZ displacement of the cell pattern, used only if i_mmc_geo=0
  i_mmc_geo = 2                 ! meridional cell geometry: 0 = whole pattern displaced towards the ITCZ, decaying as 1/(1+c_mmc_1*(fi-ficz)**2),
                                !                           1 = Hadley edges at +-width/2 + c_mmc_edge*ficz, phase linear within each Hadley cell
                               !                           2 = as 1, Ferrel/polar boundaries fixed at +-2*hw (not displaced by the ITCZ)
  c_mmc_edge = 0.4              ! displacement of both Hadley edges per degree of ITCZ displacement, used only if i_mmc_geo>=1
  c_mmc_2 = 0.025               ! 1/K, sensitivity of the ITCZ position to interhemispheric temperature gradient
  i_mmc_itcz = 1                ! ITCZ position: 0 = c_mmc_2 x interhemispheric sea level temperature contrast,
                                !                1 = c_mmc_efe x energy flux equator (efe output)
  c_mmc_efe = 0.85              ! ITCZ latitude per degree of energy flux equator, used only if i_mmc_itcz=1
  c_mmc_dt0 = 64.0              ! deg, total Hadley width at the reference tropical H*Delta_v (hdv_mmc_ref)
  c_mmc_dt1 = 0.18              ! exponent of the Held (2000) supercriticality scaling of the Hadley width (tropopause height x bulk dry stability)
  hdv_mmc_ref = 2390.           ! m, tropical H*Delta_v at which the supercriticality scaling is unity
  c_mmc_mt = 0.5                ! weight of the mountain torque [p_s dz_s/dx] in the lower-branch momentum budget: only f*M - MT is
                                ! balanced by friction and builds the zonal mean SLP; 0 = all of f*M by friction
  nsmooth_mtz = 1               ! passes of the meridional 1-2-1 smoothing of the zonal mean mountain torque before it enters the zonal SLP (0 = off)
  pbl = 0.85                    ! relative pressure (p/ps) of the PBL top, uniform in latitude
  i_dpc = 1                     ! layer below the tropopause in which the PBL ageostrophic wind is compensated:
                                ! 0 = slab of relative pressure depth dpc
                                ! 1 = fraction dpc of the troposphere in pressure, from sea level to the zonal mean tropopause
  dpc = 0.5                     ! pressure difference over which PBL ageostropic wind is compensated at the top of troposphere

  !-----------------------------------------------------------
  ! sea level pressure parameters
  !-----------------------------------------------------------
  l_p0_var = T                  ! Allow sea level pressure to vary according to topography distribution?
  p0 = 101100                   ! Pa, mean sea level pressure, used only if l_p0_var==F
  c_slp_1 = 1.5                 ! scaling factor of the thermal azonal SLP, aslp_temp = -c_slp_1*p0*ln(2)/Tm*atlay (hypsometric gain of the
                                !   sea level-500 hPa layer, 256 Pa/K at 273 K; c_slp_1=1 is the exact hypsometric gain)
  c_slp_2 = 0.1                 ! time-relaxation parameter for azonal sea level pressure
  c_aslp_eq_hb = 0.1            ! equatorial floor of the taper of the azonal SLP forcing, 1-(1-c_aslp_eq_hb)*exp(-(lat/c_aslp_eq_lat0)^2) (1 = no taper)
  c_aslp_eq_lat0 = 15.          ! deg, e-folding latitude of the equatorial taper
  c_slp_clim_f = 0.5            ! fraction of the departure of aslp_temp from its own seasonal climatology kept, all latitudes (1 = off):
                                !   aslp_temp = clim + f*(aslp_temp-clim), no seasonal lag; damps all sub-seasonal thermal-low modes
  c_slp_clim_tau = 5.           ! years, averaging time of the aslp_temp climatology (cumulative mean over the first years), used only if c_slp_clim_f<1
  n_slp_clim_harm = 4           ! number of annual harmonics of the aslp_temp climatology, used only if c_slp_clim_f<1
  l_aslp_temp_adv = T           ! displace the temperature-related azonal sea level pressure upstream of the sea level temperature anomaly?
  c_aslp_temp_tau = 2.0         ! days, relaxation time scale for the upstream displacement of the temperature-related azonal sea level pressure
  c_aslp_temp_dT = 2.           ! K, land contrast weighting of the upstream shift: tau = c_aslp_temp_tau*min(1,max(0,-C/c_aslp_temp_dT)), C = land-mean
                                !   azonal sea level temperature (tsl) of the row (shift only where/when continents are colder than the zonal mean; 0 = constant tau)
  c_aslp_temp_wtau = 20.        ! days, relaxation time of the land contrast C, used only if c_aslp_temp_dT>0
  c_uz500_pol = 3.              ! polar damping of the thermal wind in the 500 hPa zonal mean wind of the upstream displacement, min(1,c*cos(lat)**2), independent of c_uter_pol; <=0 = undamped
  l_aslp_topo = T               ! include effect of stationary topographic waves on sea level pressure? Linear barotropic vorticity equation
                                ! about the zonal mean ~300 hPa wind, coupled in latitude (one tridiagonal solve per zonal wavenumber), forced by the ~850 hPa zonal mean flow over zsa
  c_aslp_sw_amp = 1.5           ! scaling of the sea level pressure response to the ~300 hPa height anomaly (x ra*g), used only if l_aslp_topo==T
  c_aslp_sw_tau = 4.            ! days, Rayleigh damping time scale of the stationary waves, used only if l_aslp_topo==T
  c_aslp_sw_h = 8000.           ! m, scale height of the topographic vortex stretching, used only if l_aslp_topo==T
  c_aslp_sw_umin = 2.           ! m/s, minimum zonal mean wind for the wave propagation (critical lines), used only if l_aslp_topo==T
  c_aslp_sw_fr = 2.             ! Froude blocking of the topographic forcing, h_eff = h0 tanh(h/h0), h0 = c_aslp_sw_fr*max(|U_850|,c_aslp_sw_umin)/c_aslp_sw_nbv (0 = off, linear in h), used only if l_aslp_topo==T
  c_aslp_sw_nbv = 0.01          ! 1/s, Brunt-Vaisala frequency of the low-level flow for the Froude blocking, used only if c_aslp_sw_fr>0
  c_aslp_sw_lateq = 20.         ! deg, no stationary wave sea level pressure equatorward of this latitude, used only if l_aslp_topo==T
  n_aslp_sw = 12                ! maximum zonal wavenumber of the stationary waves, used only if l_aslp_topo==T

  !-----------------------------------------------------------
  ! additional dynamics parameters 
  !-----------------------------------------------------------
  i_mass_com = 1                ! placement of the column mass correction F_c = grad(psi), laplacian(psi) = -(column convergence):
                                ! 0 = the whole residual in a slab of depth dp_com below the tropopause
                                ! 1 = as 0, but the topographic part V.grad(p_s) corrected separately, with its own flux potential, 
                                !     in a terrain following band of depth dp_com_topo starting dps_com_topo above the local surface (top capped at the tropopause)
                                ! 2 = the whole residual as one correction, the same wind at every height of a terrain following band
                                !     of depth dp_com starting dps_com above the local surface (top capped at the tropopause)
                                !     With dps_com=0, dp_com=1 this is the smallest 3-D correction that closes every column, 
                                !     the fast-adjustment limit of a prognostic surface pressure, and neutral for the column heat and moisture budgets
  dps_com = 0.                  ! depth above the local surface kept free of the column mass correction (i_mass_com=2)
  dp_com = 0.1                  ! depth of the slab below the tropopause (i_mass_com=0,1), or of the terrain following band (i_mass_com=2), for the column mass correction
  dps_com_topo = 0.1            ! depth above the local surface kept free of the topographic correction (i_mass_com=1)
  dp_com_topo = 1.0             ! depth of the terrain following band of the topographic correction, top capped at the tropopause (i_mass_com=1); 1 = up to the tropopause
  ptopdyn = 0.25                ! pressure level (p/p0) above which the geostrophic (ugb,vgb) and thermal (uter,vter) winds are disregarded in the advective mass fluxes
  c_uter_pol = 3.               ! parameter for polar damping of thermal wind
  c_uter_eq = 3.                ! parameter for equatorial damping of thermal wind
  l_kata_wind = T               ! katabatic winds: inversion-layer slab with Coriolis (Ball 1960, Mahrt 1982), V_k = F/(r+if), r = cd0a*W/h_kata,
                                !     buoyancy from the Ball deficit c_kata*(gamb-gams)*hgams*(1-h_kata/(2 hgams)), unclipped slope, cells with land only
  h_kata = 100.                 ! m, surface layer thickness for katabatic winds, used only if l_kata_wind
  c_kata = 0.5                  ! factor on the Ball temperature deficit, used only if l_kata_wind
  l_kata_upw = T                ! force on cell faces with the Ball deficit of the upslope cell (F = T-point slope with the local deficit), used only if l_kata_wind

  !-----------------------------------------------------------
  ! lapse rate parameters
  !-----------------------------------------------------------
  c_gam_1 = 4.25e-3             ! K/m, background lapse rate
  c_gam_2 = 0.055               ! K/m, moisture dependence of lapse rate
  c_gam_3 = 7.46e-3             ! K/m, increase on background lapse rate at top of troposphere
  gams_min = -7.5e-3            ! K/m, surface lapse rate in the strongly stable limit
  dgams = 2.0e-3                ! K/m, unstable limit of gams = gamb + dgams*(f_ocn+f_lnd)
  sh_gams_pos = 3.              ! W/m2, sensible heat flux scale over which the surface layer changes regime (unstable side)
  sh_gams_0 = 0.                ! W/m2, sensible heat flux at the centre of the tanh between gams_min and the unstable limit
  sh_gams_neg = 5.              ! W/m2, flux scale on the stable side (sha < sh_gams_0); <= 0: same as sh_gams_pos
  c_gam_tau = 25.               ! days, relaxation time of the lapse rates gams, gamb, gamt
  c_hrm_tau = 1.25              ! days, relaxation time of the relative humidity height scale hrm
  hgams = 1500.                 ! m, height of surface layer for lapse rate
  hgamt = 15000.                ! m, height of 'troposphere' for lapse rate
  zmax = 30.e3                  ! m, maximum height for potential temperature computation

  !-----------------------------------------------------------
  ! tropopause height parameters
  !-----------------------------------------------------------
  i_rbstr = 2                   ! radiative balance of stratosphere:
                                ! 1 = longwave radiation balance only
                                ! 2 = include also solar radiation absorbtion by stratospheric O3
  c_trop_1 = 100.               ! m3/W
  c_trop_2 = 26.                ! W/m2
  c_trop_3 = 0.85               ! 

  !-----------------------------------------------------------
  ! relative humidity height scale parameters
  !-----------------------------------------------------------
  c_hrs_1 = 3000.               ! m
  c_hrs_2 = 200.                ! s/m
  c_hrs_3 = 2.4                 ! 
  c_hrs_4 = 3000.               ! m
  c_hrs_5 = 1000.               ! m
  c_hrs_6 = 0.7                 !
  rh_max_ocn = 0.9              ! maximum relative humidity over ocean/sea ice
  rh_max_lnd = 0.8              ! maximum relative humidity over land/ice sheets
  rh_strat = 0.05               ! relative humidity in stratosphere
  z_q2 = 200.                   ! m, depth of the layer the surface layer mixes with, NON-ocean types
  z_q2_ocn = 1300.              ! m, same over open ocean

  !-----------------------------------------------------------
  ! synoptic kinetic energy parameteres
  !-----------------------------------------------------------
  c_syn_1 = 3e-4                ! m2/s2/s, background synoptic energy production rate
  c_syn_2 = 1.3e2               ! m2/s2, synoptic energy production parameter
  c_syn_3 = 8.e-7               ! 1/m, background synoptic energy dissipation rate
  c_syn_4 = 1.e-4               ! 1/m, synoptic energy dissipation parameter
  i_syn_diss = 2                ! synoptic energy dissipation: 1 = (c_syn_3+c_syn_4*cda)*sam^1.5 (steady state sam ~ prod^(2/3)),
                                ! 2 = linear, (c_syn_3+c_syn_4*cda)*sqrt(syn_e0)*sam, ~1 day damping time (steady state sam ~ prod)
  syn_e0 = 140.                 ! m2/s2, reference synoptic energy of the linear dissipation, used only if i_syn_diss==2
  dz_syn_min = 1500.            ! m, EKE production shear and stability from max(z850, zsa+hgams) to max(z500, that + dz_syn_min), interpolated in height
  c_eke_slope = 1.              ! sloping-boundary stabilisation of EKE production (Blumsack and Gierasch 1972): production x max(0,1-c_eke_slope*delta), delta = terrain slope toward the cold side over the isentrope slope f*dudz over N2; 0 = off, 1 = linear Eady theory
  L_eke_slope = 1.e6            ! m, e-folding scale of a Gaussian smoothing of the terrain before the slope is taken (slope felt over the eddy scale, ~deformation radius 1e6 m); 0 = local grid slope
  c_syn_5 = 1.e4                ! s, macro-diffusivity factor for the synoptic energy, K = c_syn_5*EKE (fixed eddy time scale)
  c_syn_6 = 0.75                ! scaling from synoptic kinetic energy to synoptic wind
  c_syn_7 = 1.6e-3              ! scaling for synoptic vertical velocity at ~700 hPa, wsyn = c_syn_7*sqrt(sam)*S(lat).
  windmin = 5.                  ! m/s, minimum wind speed over the ocean
  synsurmin = 1.                ! m/s, minimum synoptic wind speed 
  tau_fac = 1.0                 ! scaling factor on the surface wind stress taux/tauy
  c_tau_syn = 2.5               ! weight of the synoptic wind in the effective speed of the wind stress, wtau = sqrt(us^2+vs^2+c_tau_syn*synsur^2)
  l_tau_stab = T                ! stability dependence of the momentum drag in the wind stress, BATS bulk Richardson factor as for the ocean heat/moisture exchange (sic i_cd_ocn=2)
  f_tau_Ri_unstab = 10.         ! Richardson number factor for unstable stratification, cd*(1-f*Ri), used only if l_tau_stab
  f_tau_Ri_stab = 0.            ! Richardson number factor for stable stratification, cd/(1+f*Ri), used only if l_tau_stab
  c_diff = 2.e4                 ! s, macro-diffusivity factor (energy, water, dust), K = c_diff*EKE (Caballero and Hanley 2012)
  h_diff = 3000.                ! m, e-folding height of the macro-diffusivity, K(z) = K*exp(-z/h_diff) (Branscome 1983 vertical structure of the baroclinic eddy flux)
                                ! <=0 = vertically uniform.
  i_hdiff_ref = 2               ! height reference for h_diff:
                                ! 1 = height above the local surface
                                ! 2 = height above sea level
  f_diff_wtr = 1.5              ! factor on the EKE macro-diffusivity for water vapour, K_q = f_diff_wtr*K (dust, CO2 and diff_stab unchanged)
  i_diff_prof = 3               ! vertical profile of the macro-diffusivity K(z):
                                ! 0 = K*exp(-z/h_diff) (h_diff, i_hdiff_ref), diffusion up to 0.2*p0
                                ! 1 = K*max(0,1-(z-z_s)/(z_t-z_s)), linear from 1 at the surface to 0 at the tropopause htrop,
                                !     z hypsometric heights of the pressure layers (only a rise of the tropopause in pressure deepens it);
                                !     h_diff and i_hdiff_ref unused; ERA-Interim fits want c_LE/c_DSE ~1.8 with this profile
                                ! 2 = K*max(0,1-z/z_t), as 1 but linear from 1 at sea level (z above sea level), so K at the ground
                                !     decreases with surface elevation (like 0 with i_hdiff_ref=2); layers below the surface carry no weight
                                ! 3 = K uniform from the surface up to the tropopause htrop, 0 above (h_diff and i_hdiff_ref unused)
  diff_stab = 3.e6              ! m2/s, additional ZONAL macro-diffusivity of all tracers (energy, water, dust, CO2), uniform in latitude,
                                ! added to c_diff*EKE with the same vertical profile; needed for numerical stability with i_adv=2
                                ! (suppresses the tropical-land ~3-day and E Asia modes). 0 = off.

  !-----------------------------------------------------------
  ! advection, diffusion and stability parameters 
  !-----------------------------------------------------------
  i_adv = 2                     ! advection scheme:
                                ! 1 = first order upstream 
                                ! 2 = flux corrected transport (Zalesak 1979)
  c_adv_polar = 0.5             ! zonal sub-cycling of the tracer advection in polar rows (|lat| > lat_adv_polar) whose zonal Courant number
                                ! exceeds c_adv_polar (strong azonal SLP near the pole): the zonal face values of those rows are replaced by
                                ! the time mean of ceil(C/c_adv_polar) upstream sub-steps along the row. Zonal inflow-mass Courant threshold
                                ! and target per sub-step
  lat_adv_polar = 75.           ! deg, the zonal sub-cycling acts only poleward of this latitude (the zonal inflow-mass Courant number is
                                ! also >1 in thin, topography-cut layers elsewhere, where the FCT upstream fallback copes)
  c_filt_conv = 1.0             ! strength [0..1] of conservative high-order 2dx filter on advective convergences (convdse/convwtr/convdst) to suppress grid-scale checkerboard; 0 = off
  nord_filt_conv = 2            ! order (selectivity) of the convergence 2dx filter

  !-----------------------------------------------------------
  ! cloud fraction parameters
  !-----------------------------------------------------------
  c_cld_1 = 0.523               !
  c_cld_2 = 0.54                !
  c_cld_3 = 160.                ! 1/(m/s), sensitivity of fweff=tanh(c_cld_3*weff) to the effective vertical velocity.
  c_cld_4 = 1.5                 !
  i_cld_low = 4                 ! low cloud scheme: 1=inversion only, 2=*ram, 3=*min(1,q_cld_low/qsat(t2a)), 4=*exp(-max(0,qam-c_cld_8)/c_cld_9)
  q_cld_low = 0.005
  c_cld_5 = 0.75                !
  c_cld_5_sc = 3.               ! i_cld_low=4 only: c_cld_5 for the warm subtropical stratocumulus regime (qam above c_cld_8)
  c_cld_6 = 0.1                 ! half-width of the inversion window (r2a-ram)
  c_cld_60_ocn = 0.0            ! centre of the inversion window (r2a-ram) over ocn+sic+lake
  c_cld_60_lnd = 0.1            ! centre of the inversion window (r2a-ram) over lnd
  c_cld_7 = 0.003               ! kg/kg, critical specific humidity for 'freezedry' reduction in cloud fraction
  c_cld_8 = 0.011               ! kg/kg, i_cld_low=4 only: qam threshold above which warm columns suppress low cloud
  c_cld_9 = 0.002               ! kg/kg, i_cld_low=4 only: e-folding scale of the warm-column suppression
  c_cld_10 = 0.00025            ! kg/kg, i_cld_low=4 only: width of the ramp from c_cld_5 to c_cld_5_sc across the c_cld_8 threshold. Keep it well below c_cld_9 
  cld_max = 0.95                ! maximum cloud fraction
  c_woro = 1e-5                 ! factor for orographic vertical velocity
  c_weff = 0.25                 ! factor for effective vertical synoptic and orographic velocity for cloud fraction

  !-----------------------------------------------------------
  ! cloud height parameters
  !-----------------------------------------------------------
  c_hcld_low = 1500.            ! m, height of the low cloud top above the surface
  c_hcld_dz_min = 1000.         ! m, minimum thickness of the radiating cloud slab in the longwave column (lwr.f90).
  c_hcld_1 = 2000.              !
  c_hcld_2 = 0.5                ! 
  c_hcld_3 = 200.               !
  c_hcld_4 = 0.                 !

  hcld_base = 1500.             ! m, 

  !-----------------------------------------------------------
  ! cloud optical thickness parameters
  !-----------------------------------------------------------
  c_clot_1 = 5.                 ! 
  c_clot_2 = 30.                !
  c_clot_3 = 2.56               ! 
  c_clot_4 = 0.447              !
  c_clot_5 = 0.                 ! weight of the dynamical factor fweff in the cloud optical thickness, 0 = off

  !-----------------------------------------------------------
  ! shortwave radiation parameters
  !-----------------------------------------------------------
  f_ice_pow = 1.                !
  r_scat   = 0.175              ! Rayleigh albedo (VU); with i_swr_ray==1 the value at cosz=0.5
  a1_w     = 0.223              !
  b1_w     = 1.863              !
  b2_w     = 0.01974            !
  c_itf_c  = 0.927              ! cloud ITF, TOA path (0.9 before i_swr_gas)
  c_itf_cc = 0.970              ! cloud ITF, surface path (0.9 before i_swr_gas)
  i_swr_ray = 1                 ! Rayleigh scattering albedo: 0 = constant r_scat, 1 = zenith-angle dependent, r_scat*(1-exp(-tau_ray/mu))/(1-exp(-tau_ray/0.5))
  tau_ray = 0.2837              ! effective Rayleigh optical depth (VU band), used only if i_swr_ray==1
  i_swr_gas = 1                 ! non-water gas absorption: 0 = constant O3 transmission (VU) 0.98, 1 = path-dependent 1-a*m^b for VU (O3) and IR (O2, CO2, CH4)
  a_gas_vu = 0.04668            ! used only if i_swr_gas==1
  b_gas_vu = 0.5624             !
  a_gas_ir = 0.03407            !
  b_gas_ir = 0.2794             !
  n_wp = -2.0                   ! SW water vapour path x (ps/p0)**n_wp (clear-sky refit vs RRTMG incl. elevated columns)
  p_cosz_sw = -0.4              ! effective cos z of the daily SW column: insolation-weighted power mean (sum cosz**(1+p)/sum cosz)**(1/p)
                                ! over the hours; -1 = daytime-mean cos z (coszm), 0 = weighted geometric mean, 1 = insolation-weighted cos z.

  !-----------------------------------------------------------
  ! longwave radiation parameters
  !-----------------------------------------------------------
  i_lw_cld = 2                  !
  c_lw_clot = 0.55              ! LW absorption coefficient of the cloud optical thickness; of liquid (warm) clouds if i_lw_cld_ice==1
  i_lw_cld_ice = 1              ! temperature-dependent LW cloud absorption coefficient per cloud layer (i_lw_cld=2 only): 0 = off, 1 = on
  c_lw_clot_ice = 0.3           ! LW absorption coefficient of ice clouds, used only if i_lw_cld_ice==1
  T_lw_ice = 251.               ! K, all-ice temperature; coefficient linear in T from c_lw_clot_ice at T_lw_ice to c_lw_clot at T0, used only if i_lw_cld_ice==1
  ak_co2 = 0.8                  !
  beta_co2 = 0.45               !
  ak_wv = 1.                    !
  a_vap = 1.6                   !
  beta_vap = 0.45               !
  a2_vap = 0.1                  !
  beta2_vap = 1.5               !
  a3_vap = 0.01                 !
  i_lwr_band = 1                ! LW spectral structure: 0 = one broadband transmission, 1 = three Planck-weighted bands (window / CO2 / water vapour rest)
  nu_win1 = 800.                ! cm-1, window band, used only if i_lwr_band==1
  nu_win2 = 1250.               ! cm-1
  nu_co21 = 550.                ! cm-1, CO2 band
  nu_co22 = 800.                ! cm-1
  k_cont = 7.029                ! window: water vapour self-continuum absorption coefficient
  c_cont_T = 3.637              ! window: continuum temperature dependence exp(c_cont_T*(296/T-1))
  k_wvw = 0.1014                ! window: weak water vapour line absorption coefficient
  ak_wvw = 0.9477               ! window: pressure scaling exponent of the weak water vapour lines
  f_wv_co2 = 0.09809            ! CO2 band: water vapour absorber amount relative to the water vapour band
  ak_co2_3b = 2.108             ! CO2 band: as ak_co2, beta_co2 and the hard-coded a0_co2, a1_co2
  beta_co2_3b = 0.3614          !
  a0_co2_3b = 0.5416            !
  a1_co2_3b = 0.09983           !
  ak_wv_3b = 0.7309             ! water vapour band: as ak_wv, a_vap, beta_vap, a2_vap, beta2_vap, a3_vap
  a_vap_3b = 6.209              !
  beta_vap_3b = 0.6845          !
  a2_vap_3b = 0.3405            !
  beta2_vap_3b = 0.3045         !
  a3_vap_3b = 0.01024           !
  ak_o3_3b = 2.266              ! window: O3, as the hard-coded ak_o3, a_o3, beta_o3
  a_o3_3b = 0.5857              !
  beta_o3_3b = 0.107            !
  k_co2w = 0.01055              ! window band: CO2 band-wing / 9.4-10.4 um absorption, transmission exp(-k_co2w*(1.66*u_co2)**b_co2w); 0 = off
  k_co2r = 0.01036              ! water vapour band: CO2 band-wing absorption, exp(-k_co2r*(1.66*u_co2)**b_co2w); 0 = off
  b_co2w = 0.373                ! exponent of the CO2 band-wing absorber amount
  c_co2_hi = 0.01392            ! CO2 band: high-CO2 transmission reduction 1-min(0.2,c_co2_hi*(u_co2/1000)**2), as in the broadband scheme
  z_top_lw = 30000.             ! m, top of the LW radiation column (was fixed at 30 km); O3 is constant above 30 km
  l_o3 = T                      !
  hpbl = 1500.                  ! m
  ecs_scale = 1.                ! scaling of effective CO2 in long-wave radiation to mimic lower (<1) or higher (>1) climate sensitivity
  ecs_scale_dT = 0.

  !-----------------------------------------------------------
  ! dust cycle settings
  !-----------------------------------------------------------
  l_dust = T                    ! switch for interactive dust cycle
  l_dust_rad = F                ! switch for radiative effect of dust in atmosphere, used only if l_dust==T
  c_dhs_1 = 2000.               ! m, reference height scale for dust
  c_dhs_2 = 8.e2                ! parameter for dependence of dust height scale on vertical velocity
  c_dust_wet = 0.075            ! scavenging parameter for wet dust deposition (m2/kg), 0.075 in Bauer 2010
  c_dust_dry = 2.5e-3           ! dry dust deposition velocity (m/s), 2.5e-3 in Bauer 2010
  c_dust_mec = 950.             ! dust mass extinction efficiency (m^2/kg)
  ars_ot = 0.106                ! background aerosol optical depth at sea level for clear sky conditions (scaled with exp(-zsa/h_ars)), used only if l_dust==F or l_dust_rad==F (0.1 with h_ars = 8 km)
  h_ars = 2000.                 ! m, aerosol scale height for the decrease of ars_ot with surface elevation (7990 = hatm, old)
  ars_im = 0.0025               ! imaginary part of dust refractive index for clear-sky conditions (0.0025: global clear-sky atm SW absorption = CERES)

  !-----------------------------------------------------------
  ! sulfate aerosols parameters 
  !-----------------------------------------------------------
  l_so4_de = T                  ! enable sulfate aerosol direct effect?
  l_so4_ie = T                  ! enable sulfate aerosol indirect effect on cloud optical thickness?
  beta_so4  = 0.23              ! upscatter fraction for sulfate aerosols (Bauer et al., 2008) 
  sigma_so4 = 3.5e3             ! m2/kg, scattering efficiency for sulfate aerosols (Bauer et al., 2008)
  r_so4 = 0.17e-6               ! m, sulfate aerosol radius (0.1-0.15 microm in Bauer 2008)
  N_so4_nat = 75e6              ! m^-3, natural cloud condensation nuclei concentration (sulfate aerosols) at cloud base

  !-----------------------------------------------------------
  ! smoothing options
  !-----------------------------------------------------------
  zsa_scale = 1                 ! topography scaling factor
  zsa_scale_dyn = 1             ! topography scaling factor for dynamics only
  nsmooth_zsa = 0               ! spatial topography smoothing 
  nsmooth_cda  = 1              ! spatial drag coefficient smoothing
  nsmooth_weff  = 2             ! spatial smoothing of effective vertical velocity
  n_aslp_shapiro = 2            ! order of the Shapiro filter of the azonal SLP forcing, once per call (response 1-sin(k dx/2)**(2n)
                                !   per direction: zero at 2 dx, flat at large scales; 0 = no filter)
  aslp_polar_lat = 65.          ! deg, latitude where the polar vorticity taper of the azonal sea level pressure forcing starts: lap(p)
                                !     of the forcing is multiplied by a raised cosine (1 at aslp_polar_lat, 0 at the pole) and inverted
                                !     per zonal wavenumber, so the vorticity decays monotonically to the pole
  nsmooth_acbar = 1             ! spatial smoothing of cross-isobar angle
  nsmooth_gam = 2               ! spatial smoothing of lapse rate 
  nsmooth_cld = 1 !0

  !-----------------------------------------------------------
  ! control of atmosphere model output
  !-----------------------------------------------------------
  l_write_timer = F             ! write simulation times of the different atm model components to standard output?
  l_daily_output = F            ! enable daily output?
  l_output_flx3d = F            ! enable output of 3D flux fields?
  l_output_extended = F         ! enable extended atmospheric output?
/
